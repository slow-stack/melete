{
  "name": "@modusensus/dsh-chat-mode",
  "version": "0.0.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "description": "Melete chat mode for DeepSeek Harness: a fast, tool-free chat preset with a chat-demo style surface. Memory via an optional MemoryProvider (mneme when installed); never hard-bound.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slow-stack/melete.git",
    "directory": "dsh-plugin"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./protocol": {
      "default": "./lib/shared/protocol.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote",
        "uiWorkspace",
        "workspaces",
        "sessions",
        "layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/schemastery": "3.18.5",
    "js-yaml": "4.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/js-yaml": "4.0.9",
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsdown": "^0.14.0",
    "typescript": "7.0.2"
  }
}
